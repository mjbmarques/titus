# Demo sketch: theme defined in config

config/themes.yaml
------------------
current: catppuccin-mocha

palettes:
  catppuccin-mocha:
    background: "#1E1E2E"
    foreground: "#CDD6F4"
    accent: "#CBA6F7"
    warning: "#F9E2AF"

